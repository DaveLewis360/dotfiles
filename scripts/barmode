#!/usr/bin/env bash
# ==============================================================================
# barmode — váltás a vízszintes (fork) és a vertikális (upstream) bar között
# ==============================================================================
# A shell élőben újratölti a beállítást, nincs szükség újraindításra.
# Hogy melyik fájl melyik kulcsa tárolja, az aktív profil .meta.json-jának
# "barmode" mezője mondja meg ({"file": ..., "key": "a.b.c"}); ha nincs, a régi
# fork extras.json-ja (bar.horizontal).
#
# Használat:
#   barmode              az aktuális mód kiírása
#   barmode h            vízszintes bar (fork, felső él)
#   barmode v            vertikális bar (eredeti caelestia, bal él)
#   barmode toggle       oda-vissza váltás
# ==============================================================================

set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/caelestia/extras.json"
KEY="bar.horizontal"

active="$(cat "$HOME/.local/state/dotfiles/active_profile" 2>/dev/null || true)"
meta="$HOME/dotfiles/profiles/$active/.meta.json"
if [[ -n "$active" && -f "$meta" ]]; then
    spec="$(python3 -c '
import json, sys
b = json.load(open(sys.argv[1])).get("barmode") or {}
if b.get("file") and b.get("key"):
    print(b["file"], b["key"])
' "$meta" 2>/dev/null || true)"
    if [[ -n "$spec" ]]; then
        CONFIG="$HOME/${spec% *}"
        KEY="${spec##* }"
    fi
fi

c_reset=$'\033[0m'; c_bold=$'\033[1m'; c_dim=$'\033[2m'
c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_cyan=$'\033[36m'

if [[ ! -f "$CONFIG" ]]; then
    mkdir -p "$(dirname "$CONFIG")"
    printf '{}\n' > "$CONFIG"
    echo "  ${c_dim}létrehozva: $CONFIG${c_reset}"
fi

read_mode() {
    python3 -c '
import json, sys
try:
    node = json.load(open(sys.argv[1]))
    for part in sys.argv[2].split("."):
        node = node.get(part, {})
    print("h" if node is True else "v")
except Exception:
    print("v")
' "$CONFIG" "$KEY"
}

write_mode() {
    python3 -c '
import json, os, sys, tempfile
path, key, want = os.path.realpath(sys.argv[1]), sys.argv[2], sys.argv[3] == "h"
with open(path) as f:
    data = json.load(f)  # A hibás JSON-t nem írjuk felül
*parents, last = key.split(".")
node = data
for part in parents:
    node = node.setdefault(part, {})
node[last] = want
# Atomi csere a symlink célján, hogy a shell soha ne lásson félig írt fájlt
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".barmode-")
with os.fdopen(fd, "w") as f:
    json.dump(data, f, indent=4, ensure_ascii=False)
    f.write("\n")
os.chmod(tmp, os.stat(path).st_mode & 0o777)
os.replace(tmp, path)
' "$CONFIG" "$KEY" "$1"
}

describe() {
    if [[ "$1" == "h" ]]; then
        echo "${c_green}vízszintes${c_reset} ${c_dim}(fork — felső él, custom/bar/HBar.qml)${c_reset}"
    else
        echo "${c_cyan}vertikális${c_reset} ${c_dim}(eredeti caelestia — bal él, modules/bar/Bar.qml)${c_reset}"
    fi
}

current="$(read_mode)"

case "${1:-}" in
    "")
        echo "  Bar mód: $(describe "$current")"
        echo "  ${c_dim}váltás:  barmode toggle${c_reset}"
        exit 0
        ;;
    h|horizontal|vízszintes|vizszintes) target="h" ;;
    v|vertical|vertikális|vertikalis)   target="v" ;;
    toggle|t)  [[ "$current" == "h" ]] && target="v" || target="h" ;;
    -h|--help|help)
        sed -n '3,15p' "$0" | sed 's/^# \?//'
        exit 0
        ;;
    *)
        echo "  ${c_yellow}Ismeretlen mód: $1${c_reset}" >&2
        echo "  Használható: h | v | toggle" >&2
        exit 1
        ;;
esac

if [[ "$target" == "$current" ]]; then
    echo "  Már ez az aktív mód: $(describe "$current")"
    exit 0
fi

write_mode "$target"
echo "  ${c_bold}Bar mód${c_reset} → $(describe "$target")"

if pgrep -x qs >/dev/null 2>&1; then
    echo "  ${c_dim}a shell élőben újratölti (~1 s)${c_reset}"
else
    echo "  ${c_yellow}a shell nem fut — indításnál lép érvénybe${c_reset}"
fi
