#!/bin/bash
# ==============================================================================
# dotswitch — Unified dotfile & quickshell profile switcher
# ==============================================================================
# Usage: dotswitch {profile_name|status|list|active|help}
# Profiles are stored in ~/dotfiles/profiles/<name>/
# Each profile has a .meta.json describing its capabilities.
# ==============================================================================

set -euo pipefail

DOTFILES_DIR="$HOME/dotfiles/profiles"
SHARED_DIR="$HOME/dotfiles/shared"
STATE_DIR="$HOME/.local/state/dotfiles"
QS_CONFIG_DIR="$HOME/.config/quickshell"
CAELESTIA_CONFIG_DIR="$HOME/.config/caelestia"
ACTIVE_FILE="$STATE_DIR/active_profile"
QML_PATH_FILE="$STATE_DIR/qml_import_path"
LOG_FILE="$STATE_DIR/switch.log"
mkdir -p "$STATE_DIR"

log() {
    echo "[$(date '+%H:%M:%S')] $*" >> "$LOG_FILE"
}

die() {
    echo "Hiba: $*" >&2
    exit 1
}

# --- Read profile metadata ---
read_meta() {
    local profile="$1"
    local key="$2"
    python3 -c "
import json, sys
try:
    with open('$DOTFILES_DIR/$profile/.meta.json') as f:
        print(json.load(f).get('$key', ''))
except Exception:
    print('')
"
}

# --- Config symlinks ---
CONFIG_ENTRIES=(
    "hypr:$HOME/.config/hypr"
    "fish:$HOME/.config/fish"
    "ghostty:$HOME/.config/ghostty"
    "foot:$HOME/.config/foot"
    "kitty:$HOME/.config/kitty"
    "waybar:$HOME/.config/waybar"
    "dunst:$HOME/.config/dunst"
    "rofi:$HOME/.config/rofi"
    "swaync:$HOME/.config/swaync"
)

# --- Find available profiles ---
list_profiles() {
    for d in "$DOTFILES_DIR"/*/; do
        name=$(basename "$d")
        meta="$d/.meta.json"
        if [[ -f "$meta" ]]; then
            desc=$(python3 -c "import json; print(json.load(open('$meta')).get('description',''))" 2>/dev/null)
            echo "  $name  $desc"
        else
            echo "  $name  (nincs meta)"
        fi
    done
}

# --- Kill running quickshell ---
kill_quickshell() {
    echo "  Folyamatok leállítása..."
    pkill -x quickshell 2>/dev/null || true
    pkill -x qs 2>/dev/null || true
    pkill -f "caelestia shell" 2>/dev/null || true
    pkill -x waybar 2>/dev/null || true
    pkill -x dunst 2>/dev/null || true
    pkill -x swaync 2>/dev/null || true
    # Rice-ok által indított egyéb démonok
    pkill -x hypridle 2>/dev/null || true
    pkill -x hyprsunset 2>/dev/null || true
    pkill -f "waybar.py" 2>/dev/null || true
    pkill -f "wallpaper.sh" 2>/dev/null || true
    pkill -x nm-applet 2>/dev/null || true
    pkill -x blueman-applet 2>/dev/null || true
    pkill -x udiskie 2>/dev/null || true
    sleep 1
    pkill -9 -x quickshell 2>/dev/null || true
    pkill -9 -x qs 2>/dev/null || true
    pkill -9 -f "caelestia shell" 2>/dev/null || true
    
    rm -rf "$HOME/.cache/quickshell/qmlcache" 2>/dev/null || true
    rm -rf "$HOME/.cache/quickshell/qtpipelinecache-x86_64-little_endian-lp64" 2>/dev/null || true
    log "QML cache törölve"
}

# --- Start quickshell for the active profile ---
start_quickshell() {
    local profile="$1"
    local shell_type
    local qs_source
    local qml_path
    
    shell_type=$(read_meta "$profile" "shell_type")
    qs_source=$(read_meta "$profile" "quickshell_source")
    qml_path=$(read_meta "$profile" "qml_import_path")

    # Give Wayland time to clear sockets if we just killed something
    sleep 0.5

    # Build the environment prefix for quickshell
    local env_prefix=""
    if [[ -n "$qml_path" ]]; then
        env_prefix="QML_IMPORT_PATH=$qml_path"
    fi

    case "$shell_type" in
        "caelestia")
            echo "  Caelestia shell indítása..."
            mkdir -p "$QS_CONFIG_DIR"
            if [[ -n "$qs_source" ]]; then
                ln -sfn "$qs_source" "$QS_CONFIG_DIR/caelestia"
            fi
            
            if command -v caelestia >/dev/null; then
                 eval "$env_prefix caelestia shell -d >/dev/null 2>&1 &"
                 log "Caelestia shell indítva (caelestia tool)"
            else
                 eval "$env_prefix nohup quickshell -c caelestia >/dev/null 2>&1 &"
                 log "Caelestia shell indítva (direct quickshell)"
            fi
            ;;
        "end4")
            echo "  end_4 shell indítása..."
            mkdir -p "$QS_CONFIG_DIR"
            if [[ -n "$qs_source" ]]; then
                ln -sfn "$qs_source" "$QS_CONFIG_DIR/ii"
            fi
            eval "$env_prefix nohup quickshell -c ii >/dev/null 2>&1 &"
            log "end_4 shell indítva"
            ;;
        *)
            echo "  ⚠ Ismeretlen shell_type: '$shell_type'. Nem indítunk Quickshell-t."
            log "Ismeretlen shell_type: $shell_type"
            ;;
    esac
}

# --- Set QML import path from profile ---
set_qml_path() {
    local profile="$1"
    local qml_path
    qml_path=$(read_meta "$profile" "qml_import_path")

    if [[ -n "$qml_path" ]]; then
        echo "$qml_path" > "$QML_PATH_FILE"
        export QML_IMPORT_PATH="$qml_path"
        log "QML_IMPORT_PATH: $qml_path"
    else
        > "$QML_PATH_FILE"
        log "QML_IMPORT_PATH: (nincs)"
    fi
}

# --- Switch config symlinks ---
switch_configs() {
    local profile="$1"
    local meta="$DOTFILES_DIR/$profile/.meta.json"
    local count=0

    if [[ ! -f "$meta" ]]; then
        die "Nincs .meta.json a profilban: $profile"
    fi

    for entry in "${CONFIG_ENTRIES[@]}"; do
        local subdir="${entry%%:*}"
        local target="${entry#*:}"
        local src="$DOTFILES_DIR/$profile/$subdir"
        
        # End4 compat: check for 'dots/.config/hypr' etc
        if [[ ! -d "$src" && -d "$DOTFILES_DIR/$profile/dots/.config/$subdir" ]]; then
             src="$DOTFILES_DIR/$profile/dots/.config/$subdir"
        fi

        local should_create=false
        if [[ -d "$src" ]]; then
            local enabled
            enabled=$(python3 -c "
import json
try:
    with open('$meta') as f:
        cfg = json.load(f).get('configs', {})
        print(str(cfg.get('$subdir', True)).lower())
except:
    print('true')
" 2>/dev/null || echo "true")
            [[ "$enabled" == "true" ]] && should_create=true
        fi

        if [[ "$should_create" == "true" ]]; then
            mkdir -p "$(dirname "$target")"
            if [[ -d "$target" && ! -L "$target" ]]; then
                mv "$target" "${target}.bak-dotswitch-$(date +%s)"
                echo "  ⚠ Eredeti $subdir lementve"
                log "Biztonsági mentés: $target"
            fi
            # ATOMIC SYMLINK
            ln -sfn "$src" "$target"
            echo "  ✓ $subdir"
            count=$((count + 1))
        elif [[ -L "$target" ]]; then
            # Profile doesn't manage this config; remove stale symlink that
            # dotswitch itself created (points into the profiles dir).
            local current
            current=$(readlink "$target")
            if [[ "$current" == "$DOTFILES_DIR/"* ]]; then
                rm "$target"
                echo "  ↺ $subdir (elavult symlink törölve)"
                log "Elavult symlink törölve: $subdir -> $current"
            fi
        fi
    done

    local hypr_dir="$HOME/.config/hypr"
    local current_shell_type
    current_shell_type=$(read_meta "$profile" "shell_type")

    # A közös overlay a Lua-generálás ELŐTT fut, hogy a .conf legyen az egyetlen
    # igazságforrás: a translator abból állítja elő a .lua-t. Így egy külön
    # lefuttatott translator sem törli el a közös beállításokat.
    apply_overlay "$profile"

    if [[ -d "$hypr_dir" ]]; then
        echo "  Lua configok generálása/frissítése a .conf fájlokból..."
        python3 "$HOME/dotfiles/scripts/translate_hypr_lua.py" "$hypr_dir" >/dev/null 2>&1 || true
        log "Lua configok frissítve"
    fi

    # Caelestia JSONs
    local shell_json_src="$DOTFILES_DIR/$profile/shell.json"
    local cli_json_src="$DOTFILES_DIR/$profile/cli.json"
    if [[ -f "$shell_json_src" ]]; then
        mkdir -p "$CAELESTIA_CONFIG_DIR"
        ln -sfn "$shell_json_src" "$CAELESTIA_CONFIG_DIR/shell.json"
        echo "  ✓ shell.json"
        count=$((count + 1))
    elif [[ -L "$CAELESTIA_CONFIG_DIR/shell.json" ]]; then
        local current
        current=$(readlink "$CAELESTIA_CONFIG_DIR/shell.json")
        if [[ "$current" == "$DOTFILES_DIR/"* ]]; then
            rm "$CAELESTIA_CONFIG_DIR/shell.json"
            echo "  ↺ shell.json (elavult symlink törölve)"
            log "Elavult symlink törölve: shell.json -> $current"
        fi
    fi
    if [[ -f "$cli_json_src" ]]; then
        mkdir -p "$CAELESTIA_CONFIG_DIR"
        ln -sfn "$cli_json_src" "$CAELESTIA_CONFIG_DIR/cli.json"
        echo "  ✓ cli.json"
        count=$((count + 1))
    elif [[ -L "$CAELESTIA_CONFIG_DIR/cli.json" ]]; then
        local current
        current=$(readlink "$CAELESTIA_CONFIG_DIR/cli.json")
        if [[ "$current" == "$DOTFILES_DIR/"* ]]; then
            rm "$CAELESTIA_CONFIG_DIR/cli.json"
            echo "  ↺ cli.json (elavult symlink törölve)"
            log "Elavult symlink törölve: cli.json -> $current"
        fi
    fi

    log "Configok váltva: $count db"
}

# --- Apply common overlay settings (kb_layout etc.) to the profile ---
apply_overlay() {
    local profile="$1"
    local target_rel target_fmt
    target_rel=$(read_meta "$profile" "overlay_target")
    target_fmt=$(read_meta "$profile" "overlay_format")

    if [[ -z "$target_rel" || -z "$target_fmt" || ! -f "$SHARED_DIR/common.json" ]]; then
        log "Overlay kihagyva (nincs target/format/common.json): $profile"
        return 0
    fi

    local target="$HOME/$target_rel"
    mkdir -p "$(dirname "$target")"

    # A stderr-t NEM nyomjuk el: az apply_overlay.py ott jelzi, ha egy bind
    # dispatchere nincs leképezve a profil formátumára. Csendben rossz configot
    # generálni sokkal rosszabb, mint egy látható figyelmeztetés.
    local overlay_err
    # A cliToggles nem hypr config, hanem a `caelestia toggle <név>` app-
    # definíciói — azok a caelestia CLI cli.json-jába olvadnak be. Így a
    # SUPER+M / SUPER+D minden profilban ugyanazt az appot nyitja, nem csak
    # abban, ahol épp be volt írva.
    overlay_err=$(python3 "$HOME/dotfiles/scripts/apply_overlay.py" \
        "$SHARED_DIR/common.json" "$target" "$target_fmt" \
        --cli-target "$CAELESTIA_CONFIG_DIR/cli.json" 2>&1 >/dev/null)
    local overlay_rc=$?

    if [[ $overlay_rc -eq 0 ]]; then
        echo "  ✓ overlay ($target_fmt): közös beállítások → $target_rel"
        log "Overlay alkalmazva: $target ($target_fmt)"
        if [[ -n "$overlay_err" ]]; then
            while IFS= read -r line; do
                [[ -n "$line" ]] && echo "  ⚠ $line"
            done <<< "$overlay_err"
            log "Overlay figyelmeztetések: $overlay_err"
        fi
    else
        echo "  ⚠ overlay hiba: $target_rel"
        [[ -n "$overlay_err" ]] && echo "     $overlay_err"
        log "Overlay HIBA: $target — $overlay_err"
        return 0
    fi

    # Több profil overlay-célja lehet UGYANAZ a fájl (a caelestia profilok mind a
    # ~/.config/caelestia/hypr-user.lua-t használják), és azt a my-caelestia profil
    # is betölti. Ha egy korábbi profil managed blokkja bennemarad, a bindok
    # MEGDUPLÁZÓDNAK — két egymást kioltó toggle. Ezért minden más profil
    # célfájljából kitakarítjuk a blokkot.
    local other other_target other_fmt other_abs
    for other in "$DOTFILES_DIR"/*/; do
        other=$(basename "$other")
        [[ "$other" == "$profile" ]] && continue
        other_target=$(read_meta "$other" "overlay_target")
        other_fmt=$(read_meta "$other" "overlay_format")
        [[ -z "$other_target" || -z "$other_fmt" ]] && continue
        [[ "$other_target" == "$target_rel" ]] && continue
        other_abs="$HOME/$other_target"
        [[ -f "$other_abs" ]] || continue
        if python3 "$HOME/dotfiles/scripts/apply_overlay.py" --strip \
                "$other_abs" "$other_fmt" 2>/dev/null; then
            log "Elavult managed blokk törölve: $other_abs (profil: $other)"
        fi
    done

    # If the override file is a tracked file inside a profile git repo (e.g. end4),
    # hide the local change so the repo stays 'pristine' in git status.
    local real repo rel
    real=$(realpath "$target" 2>/dev/null || echo "$target")
    repo=$(git -C "$(dirname "$real")" rev-parse --show-toplevel 2>/dev/null || true)
    if [[ -n "$repo" ]]; then
        rel="${real#"$repo"/}"
        if git -C "$repo" ls-files --error-unmatch "$rel" >/dev/null 2>&1; then
            git -C "$repo" update-index --skip-worktree "$rel" 2>/dev/null && log "skip-worktree: $rel"
        fi
    fi
}

# --- Detect which Hyprland config parser a profile needs ---
# A Hyprland INDULÁSKOR választ parsert: ha van hyprland.lua, azt tölti (Lua
# parser), különben hyprland.conf-ot (hyprlang). Menet közben NEM tud váltani
# — a 'hyprctl keyword' ilyenkor ezt mondja:
#   "keyword can't work with non-legacy parsers. Use eval."
# Ezért két különböző formátumú profil között újra kell lépni a sessionbe.
profile_hypr_format() {
    local profile="$1"
    local dir="$DOTFILES_DIR/$profile/hypr"
    [[ -d "$dir" ]] || dir="$DOTFILES_DIR/$profile/Configs/.config/hypr"
    [[ -d "$dir" ]] || dir="$DOTFILES_DIR/$profile/dots/.config/hypr"
    if [[ -f "$dir/hyprland.lua" ]]; then
        echo "lua"
    elif [[ -f "$dir/hyprland.conf" ]]; then
        echo "conf"
    else
        echo "?"
    fi
}

# Amit a FUTÓ Hyprland használ: a configerrors elárulja, ha .lua-t keres,
# egyébként a betöltött fájl létezéséből következtetünk.
running_hypr_format() {
    if ! hyprctl instances >/dev/null 2>&1; then
        echo "?"
        return
    fi
    # Ha a Lua parser aktív, a 'keyword' hibát ad non-legacy parser miatt
    if hyprctl keyword general:border_size "$(hyprctl getoption general:border_size -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["int"])' 2>/dev/null || echo 1)" 2>&1 | grep -q "non-legacy"; then
        echo "lua"
    else
        echo "conf"
    fi
}

# --- Warn if the parser format changes (needs re-login) ---
check_hypr_format() {
    local profile="$1"
    local want running
    want=$(profile_hypr_format "$profile")
    running=$(running_hypr_format)

    if [[ "$want" == "?" || "$running" == "?" || "$want" == "$running" ]]; then
        return 0
    fi

    echo ""
    echo "  ════════════════════════════════════════════════════════"
    echo "  ⚠  ÚJRALÉPÉS KELL A SESSIONBE"
    echo "  ════════════════════════════════════════════════════════"
    echo "  A futó Hyprland '$running' formátumú configot használ,"
    echo "  ez a profil viszont '$want' formátumút."
    echo ""
    echo "  A Hyprland INDULÁSKOR választ parsert, és menet közben nem tud"
    echo "  váltani .lua és .conf között. A symlinkek már a helyükön vannak,"
    echo "  de a config CSAK újralépés után lép érvénybe."
    echo ""
    echo "  Addig a régi config marad aktív, és a 'hyprctl configerrors'"
    echo "  a hiányzó fájlra fog panaszkodni — ez ilyenkor normális."
    echo ""
    echo "  Kilépés:  hyprctl dispatch exit    (vagy Ctrl+Alt+Delete)"
    echo "  ════════════════════════════════════════════════════════"
    log "FORMÁTUMVÁLTÁS: futó=$running, cél=$want -> újralépés kell"
}

# --- Reload Hyprland ---
reload_hypr() {
    if hyprctl instances >/dev/null 2>&1; then
        echo "  Hyprland újratöltése..."
        hyprctl reload 2>/dev/null || true
        log "Hyprland reload"
    else
        echo "  ⚠ Hyprland nem fut, reload elmaradt."
    fi
}

# --- Apply terminal colors ---
apply_colors() {
    if [[ -f "$HOME/dotfiles/scripts/update_css_vars.py" ]]; then
        echo "  Színek alkalmazása..."
        CAELESTIA_WATCHER=1 python3 "$HOME/dotfiles/scripts/update_css_vars.py" 2>/dev/null || true
        log "Színek alkalmazva"
    fi
}

# --- Start profile services ---
start_services() {
    # Jelenleg egyik profil sem igényel külön szolgáltatás-indítást: a
    # quickshell-alapúakat a start_shell kezeli. A függvény megmarad, hogy a
    # váltási folyamat szerkezete ne változzon, ha később kell ide valami.
    :
}

# --- State management ---
set_active() {
    local profile="$1"
    echo "$profile" > "$ACTIVE_FILE"
}

get_active() {
    if [[ -f "$ACTIVE_FILE" ]]; then
        cat "$ACTIVE_FILE"
    else
        echo ""
    fi
}

# ==============================================================================
# COMMANDS
# ==============================================================================
case "${1:-help}" in
    # --- SWITCH PROFILE ---
    my-caelestia|mine|caelestia|upstream|stable|git|rolling|end4)
        case "$1" in
            my-caelestia|mine)
                profile="my-caelestia"
                desc="Saját Caelestia"
                ;;
            git|rolling|stable|caelestia|upstream)
                # A 'stable' vonal megszűnt (két azonos tagen álló klón volt).
                # A megszokott nevek a megmaradt upstream referenciára visznek.
                profile="git"
                desc="Caelestia upstream (git main)"
                ;;
            end4)
                profile="end4"
                desc="end_4 Illogical Impulse"
                ;;
        esac

        if [[ ! -d "$DOTFILES_DIR/$profile" ]]; then
            die "Profil nem található: $profile"
        fi

        echo "════════════════════════════════════════"
        echo "  Váltás: $desc ($profile)"
        echo "════════════════════════════════════════"

        kill_quickshell
        set_qml_path "$profile"
        switch_configs "$profile"
        set_active "$profile"
        
        start_quickshell "$profile"
        reload_hypr
        start_services "$profile"
        apply_colors
        check_hypr_format "$profile"

        echo ""
        echo "  ✓ Aktív profil: $desc"
        echo "  ⚠ Javasolt Logout/Login a teljes váltáshoz!"
        echo "════════════════════════════════════════"
        ;;

    status)
        echo "════════════════════════════════════════"
        echo "  DOTFILES RENDSZER ÁLLAPOT"
        echo "════════════════════════════════════════"
        active=$(get_active)
        echo "  Aktív profil: ${active:-ismeretlen}"
        echo ""
        echo "  Config symlinkek:"
        for entry in "${CONFIG_ENTRIES[@]}"; do
            subdir="${entry%%:*}"
            target="${entry#*:}"
            link=$(readlink "$target" 2>/dev/null || echo "nem symlink")
            echo "    $subdir → $link"
        done
        echo ""
        echo "  Elérhető profilok:"
        list_profiles
        echo "════════════════════════════════════════"
        ;;

    list) list_profiles ;;
    active) get_active ;;
    help|--help|-h)
        echo "Használat: dotswitch {mine|end4|git|stable|status|list|active|help}"
        ;;
    *)
        die "Ismeretlen parancs: $1"
        ;;
esac
