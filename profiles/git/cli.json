{
    "wallpaper": {
        "postHook": ""
    },
    "theme": {
        "enableTerm": false
    },
    "toggles": {
        "communication": {
            "discord": {
                "_comment": "A zen-app-runtime Discord appja (zen-app-discord). Ha nem fut, elindítja; ha fut, a SUPER+D előhozza vagy elrejti.",
                "command": [
                    "zen-app",
                    "run",
                    "discord"
                ],
                "match": [
                    {
                        "class": "zen-app-discord"
                    }
                ]
            }
        },
        "music": {
            "spotify": {
                "_comment": "A zen-app-runtime Spotify appja (zen-app-spotify). Ha nem fut, elindítja; ha fut, a SUPER+M előhozza vagy elrejti.",
                "command": [
                    "zen-app",
                    "run",
                    "spotify"
                ],
                "match": [
                    {
                        "class": "zen-app-spotify"
                    }
                ]
            }
        },
        "sysmon": {
            "btop": {
                "_comment": "A ghostty érvényes GTK app-ID-t vár; a puszta 'btop'-ot csendben eldobja. Ezért kell a reverse-DNS forma.",
                "command": [
                    "app2unit",
                    "--",
                    "ghostty",
                    "--class=com.mitchellh.ghostty.btop",
                    "-e",
                    "btop"
                ],
                "match": [
                    {
                        "class": "com.mitchellh.ghostty.btop"
                    }
                ]
            }
        }
    },
    "record": {
        "extraArgs": []
    }
}
