  "author": "DaveLewis360",
  "quickshell_source": "/home/dave/Reference/my-caelestia-shell-bar",
  "qml_import_path": "/home/dave/Reference/my-caelestia-shell-bar/build/qml",
  "shell_type": "caelestia",
  "wallpaper_dir": "/home/dave/Pictures/Wallpapers",
  "configs": {
    "hypr": true,
    "fish": true,
    "ghostty": true,
    "foot": true,
    "shell_json": true,
